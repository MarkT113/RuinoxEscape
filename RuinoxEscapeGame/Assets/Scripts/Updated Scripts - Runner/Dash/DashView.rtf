\f0\fs24 \cf0 using System;\
using System.Collections;\
using System.Collections.Generic;\
using UnityEngine.SceneManagement;\
using UnityEngine;\
using UnityEngine.EventSystems;\
using UnityEngine.UI;\
\
public class CollisionManager : MonoBehaviour\
\{\
    private Image[] dashPanel;\
    private Sprite usedDash;\
    private GameObject dashIconPrefab;\
    private GameObject parentContainer;\
    private RectTransform parentContainerRect;\
    private GameObject grandparentContainer;\
    private RectTransform grandparentContainerRect;\
\
    void Awake()\
    \{\
        parentContainerRect = parentContainer.GetComponent<RectTransform>();\
        grandparentContainerRect = grandparentContainer.GetComponent<RectTransform>();\
    \}\
\
    public void InitDashDisplay(float numOfDashes)\
    \{\
        float parentWidth = numOfDashes * 230f;\
        float grandparentWidth = parentWidth + 300f;\
        float grandparentXPosition = -0.5f * grandparentWidth + 90f;\
\
        parentContainerRect.sizeDelta = new Vector2(parentWidth, parentContainerRect.sizeDelta.y);\
        \
        dashPanel = new Image[numOfPrefabs];\
        for (int i = 0; i < numOfPrefabs; i++)\
        \{\
            dashPanel[i] = Instantiate(dashIconPrefab, parentContainer.transform);\
        \}\
\
        grandparentContainerRect.sizeDelta = new Vector2(grandparentWidth, grandparentContainerRect.sizeDelta.y);\
        grandparentContainerRect.anchoredPosition = new Vector2(grandparentXPosition, -120);\
    \}\
\
    public void UpdateDashUI(int dashesRemaining)\
    \{\
        for (int i = dashesRemaining; i < dashPanel.Length; i++)\
        \{\
            dashPanel[i].sprite = usedDash;  // Show empty dashes\
        \}\
    \}\
\}}