\f0\fs24 \cf0 using System;\
using System.Collections;\
using System.Collections.Generic;\
using UnityEngine.SceneManagement;\
using UnityEngine;\
\
public class PlayerController : MonoBehaviour\
\{\
    public PlayerModel playerData;\
    public PlayerView playerView;\
\
    private Rigidbody2D rb;\
    private Animator playerAnimator;\
    private horAxisInput;\
    private float targetInputVal;\
    private bool moveLeft;\
    private bool moveRight;\
\
    void Awake()\
    \{\
        playerData = playerModel.Instance;\
        horAxisInput = playerData.horizontalMoveInput\
        targetInputVal = playerData.targetHorVelocity;\
        rb = GetComponent<Rigidbody2D>();\
        playerAnimator = GetComponent<Animator>();\
        rb.freezeRotation = true;\
        rb.gravityScale = 0f;\
        x += SavePlayerData;\
    \}\
\
    void Update()\
    \{\
        //if (playerData.isDead) return; // Redundant (as \'91Time.timeScale = 0\'92 is used)\
\
        targetInputVal = (moveLeft) ? -1f : (moveRight) ? 1f : 0f;\
        horAxisInput = Mathf.MoveTowards(horAxisInput, targetInputVal, playerData.ControlsSensitivity * Time.deltaTime);\
\
        //playerView.MovePlayer(horAxisInput);\
        playerAnimator.SetFloat("inputX", horAxisInput);\
    \}\
\
    void FixedUpdate()\
    \{\
        rb.velocity = new Vector2(horAxisInput * playerData.playerVelocity, 0);\
    \}\
\
    public void StartMoveLeft()\
    \{\
        moveLeft = moveRight ? false : true;\
    \}\
    \
    public void EndMoveLeft()\
    \{\
        moveLeft = false;\
    \}\
    \
    public void StartMoveRight()\
    \{\
        if (!moveLeft)\
            moveRight = true;\
    \}\
\
    public void EndMoveRight()\
    \{\
        moveRight = false;\
    \}\
\
    private void SavePlayerData()\
    \{\
        playerData.horizontalMoveInput = horAxisInput;\
        playerData.targetHorVelocity = targetInputVal;\
    \}\
\}}